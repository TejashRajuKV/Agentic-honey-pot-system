PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/honeypot
API_KEY=change-me
# Web console credentials (required in production)
# CONSOLE_PASSWORD=use-a-unique-password-at-least-12-characters-long
# CONSOLE_SESSION_SECRET=generate-at-least-32-random-bytes
# Optional
LLM_API_KEY=
# Leave empty to use the GUVI default endpoint; set only for staging/testing
EVALUATION_CALLBACK_URL=
HIBP_API_KEY=
NODE_ENV=development
# Comma-separated browser origins allowed by CORS. Same-origin production UI needs no entry.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Maximum JSON request body size (Express body parser syntax)
JSON_BODY_LIMIT=1mb
# ML request timeout in milliseconds
ML_TIMEOUT_MS=2500

# ML engine (spawned and supervised by the gateway)
ML_PORT=5050
CYBERRAKSHAK_URL=http://127.0.0.1:5050
ML_AUTO_START=true
# PYTHON_BIN=python

# Seconds-scale guard: how long DB calls wait before failing when MongoDB is down (ms)
# DB_BUFFER_TIMEOUT_MS=2500

# Webhook delivery: HTTPS is required. Only enable HTTP for controlled development targets.
# ALLOW_INSECURE_WEBHOOKS=false
