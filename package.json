{
  "name": "cyberrakshak-platform",
  "version": "1.0.0",
  "description": "CyberRakshak — AI-powered cybersecurity platform: agentic honeypot, ML threat detection and a unified web console in one project",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev.js",
    "build": "npm --prefix frontend run build",
    "build:start": "npm run build && npm start",
    "install:all": "npm install && npm --prefix frontend install && python -m pip install -r requirements.txt",
    "test:e2e": "node scripts/e2e.js",
    "test": "node scripts/e2e.js",
    "test:readiness": "node tests/readiness/run.js",
    "test:threat-network": "node tests/threat-network-correlation.js",
    "test:webhook-policy": "node tests/webhook-url-policy.js",
    "test:rate-limit": "node tests/rate-limit.js"
  },
  "keywords": [
    "honeypot",
    "scam-detection",
    "ai-agent",
    "fraud-prevention"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "franc": "^6.2.0",
    "mongoose": "^9.1.5",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11",
    "puppeteer-core": "^25.11.0"
  }
}
